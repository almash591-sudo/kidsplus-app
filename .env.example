# Скопируйте в .env и заполните. Файл .env не коммитится.
# На Railway те же переменные задаются в настройках сервисов.

NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# PostgreSQL. Локально: docker compose up -d db
DATABASE_URL=postgres://kidsplus:kidsplus@localhost:5432/kidsplus

# API (на Railway PORT задаётся автоматически)
PORT=3000

# Токен первичной настройки: открыть http://localhost:5174/setup?token=<значение>
# и создать первый родительский аккаунт. Минимум 24 символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SETUP_TOKEN=

# Адрес детского PWA — для ссылки в QR-коде привязки устройства
KID_APP_URL=http://localhost:5173

# Сколько прокси перед api (Railway edge + Caddy = 2; локально через vite — без разницы)
TRUST_PROXY_HOPS=2

# ─── Этап 2: хранилище и озвучка ─────────────────────────────────────────────
# Хранилище медиа: fs (папка MEDIA_DIR, путь от папки приложения), db (таблица media_blobs
# в PostgreSQL — так на бесплатном Railway) или s3 (Railway Bucket).
STORAGE_DRIVER=fs
MEDIA_DIR=../../media
# Для STORAGE_DRIVER=s3 (на Railway задаются ссылками на bucket `media`).
# Аудиотека (этап 20) берёт этот bucket, если заданы все четыре S3_*, даже при STORAGE_DRIVER=db;
# иначе аудио хранится там же, где картинки. Cloudflare R2: S3_ENDPOINT=https://<id аккаунта>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Кто озвучивает: browser — телефон ребёнка (Web Speech API, по умолчанию); google — сервер.
TTS_PROVIDER=browser

# Google Cloud Text-to-Speech (нужен worker'у при TTS_PROVIDER=google). Ключ ограничьте в консоли Google одним
# Cloud Text-to-Speech API. Без ключа озвучка не генерируется.
GOOGLE_TTS_API_KEY=
# TTS_PROVIDER=elevenlabs — ключ ElevenLabs (голос по умолчанию Matilda, многоязычный)
ELEVENLABS_API_KEY=
# TTS_PROVIDER=proxyapi — ElevenLabs через ProxyAPI (proxyapi.ru, оплата в рублях)
PROXYAPI_KEY=
# Скорость речи (0.5–1.5; для малышей медленнее обычной) и голоса по языкам (необязательно,
# например ru-RU-Wavenet-A). От них зависит ключ кэша озвучки.
TTS_SPEED=0.85
TTS_VOICE_RU=
TTS_VOICE_EN=
TTS_VOICE_ZH=

# Модерация видео (этап 3). Ключ YouTube Data API v3 (api и worker): метаданные, плейлисты, каналы,
# ежедневная проверка доступности. Без него — только видео по одному через oEmbed.
YOUTUBE_API_KEY=
# Регион, где смотрят дети (проверка региональных ограничений), и максимальная длина видео для анализа.
VIDEO_REGION=RU
MODERATION_MAX_VIDEO_MIN=30
# Gemini API (только worker): модель смотрит публичное видео YouTube по ссылке и готовит отчёт.
GEMINI_API_KEY=
LLM_MODEL_MAIN=gemini-3.8-flash
# Лимиты токенов модели: в сутки и всего (п. 7.4 ТЗ). Превышен — очередь модерации ждёт.
LLM_DAILY_TOKEN_LIMIT=2000000
LLM_TOTAL_TOKEN_LIMIT=100000000

# Push-уведомления родителям (этап 5): ключи VAPID для api и worker.
# Сгенерировать: pnpm --filter @kidsplus/providers exec node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://parent.example.com

# Снимки детей: квота копий на сервере, МБ (этап 9).
CAPTURES_QUOTA_MB=200
# Звонки: серверы ICE (JSON). Пусто — открытые STUN; TURN — {"iceServers":[{"urls":"turn:…","username":"…","credential":"…"}]}
ICE_SERVERS=
