# Лендинг KidsPlus (этап 24): статический сайт apps/landing на коротком домене.
# Вход и приглашения ведут в кабинет родителя (PARENT_URL).
# Переменные окружения:
#   PARENT_URL  адрес кабинета, например https://parent-web-…up.railway.app
#   PORT        порт (Railway задаёт сам)

{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	@cabinet path /login /login/* /invite /invite/* /setup /setup/*
	handle @cabinet {
		redir {$PARENT_URL}{uri} 302
	}

	handle {
		root * /srv
		@static path /fonts/* /img/*
		header @static Cache-Control "public, max-age=2592000"
		@woff2 path *.woff2
		header @woff2 Content-Type font/woff2
		@pages path / /guide /index.html /guide.html
		header @pages Cache-Control "no-cache"
		try_files {path} {path}.html /index.html
		file_server
	}
}
